# ─────────────────────────────────────────────────────────────
# AskRoo — environment variables
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────

# Public site URL (no trailing slash). Used for canonical URLs,
# sitemap, robots, OG image and JSON-LD. Falls back to the value
# in src/lib/site.ts if unset.
NEXT_PUBLIC_SITE_URL="https://askroo.com.au"

# ── Contact form (Resend transactional email) ──
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=""

# The verified sender address the contact form emails come *from*.
# Must be on a domain you've verified in Resend.
CONTACT_FROM_EMAIL="AskRoo <connect@askroo.io>"

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL="connect@askroo.io"
